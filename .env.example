X_USERNAME=
X_PASSWORD=
IG_USERNAME=
IG_PASSWORD=

# ── LinkedIn (Phase B) ─────────────────────────────────────────────────────────
# WARNING: LinkedIn DOM selectors are @unverified — they need a live session to confirm.
# Login: forge-social login --platform linkedin
# Conservative default cap: 2/day. Ported login/captcha logic from forge-linkedin (private).
# See docs/PORTED-FROM-forge-linkedin.md for porting notes.
LI_USERNAME=
LI_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Brand placeholders (fill these to render campaign posts correctly) ─────────
# These replace {echo_url}, {forge_url}, etc. in campaign content at post time.
FORGE_SOCIAL_ECHO_URL=           # e.g. https://echo.sbknext.com
FORGE_SOCIAL_FORGE_URL=          # default: https://forge.sbknext.com
FORGE_SOCIAL_MCP_URL=            # default: https://mcp.sbknext.com
FORGE_SOCIAL_HANDLE=             # your name/brand handle (no @), e.g. sbknext
FORGE_SOCIAL_X_HANDLE=           # X/Twitter @handle (no @), e.g. sbknext
FORGE_SOCIAL_IG_HANDLE=          # Instagram @handle (no @), e.g. sbknext

# ── Bluesky (Phase G — API, no browser) ───────────────────────────────────────
# Get an app password at: https://bsky.app/settings/app-passwords (NOT your main password)
BLUESKY_HANDLE=                  # your Bluesky handle, e.g. yourname.bsky.social
BLUESKY_APP_PASSWORD=            # app password generated in Bluesky settings
BLUESKY_PDS=                     # optional; default: https://bsky.social

# ── Mastodon (Phase G — API, no browser) ──────────────────────────────────────
# Create a developer app at https://<your-instance>/settings/applications
MASTODON_INSTANCE=               # your instance domain, e.g. mastodon.social
MASTODON_TOKEN=                  # access token from your Mastodon developer app

# ── Dev.to / Forem (Phase G — API, no browser) ────────────────────────────────
# Get your API key at: https://dev.to/settings/extensions (scroll to "DEV API Keys")
DEVTO_API_KEY=                   # API key from dev.to settings
